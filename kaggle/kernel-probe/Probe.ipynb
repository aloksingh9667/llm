   "source": [
    "# Probe: what does an attached kernel output look like?\n",
    "Lists /kaggle/input recursively. CPU, ~2 min."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!echo '--- /kaggle/input tree ---'\n",
    "!find /kaggle/input -maxdepth 3 2>&1 | head -50\n",
    "!echo '--- env ---'\n",
    "!env | grep -i kaggle"
   ]
  }
